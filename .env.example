# ─────────────────────────────────────────────
# CascadeCity — Environment Variables Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL database URL (required for persistent storage)
# Supported: Neon, Supabase, Railway, local Postgres
DATABASE_URL="postgresql://user:password@host:5432/cascadecity?schema=public"

# ── AI / LLM ──────────────────────────────────
# Groq API key for policy generation and AI chat (Llama 3.1 70B)
# Get from: https://console.groq.com
GROQ_API_KEY=""

# ── SMS / WhatsApp ────────────────────────────
# Twilio credentials for OTP delivery and farmer alerts
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1234567890"

# ── Air Quality ───────────────────────────────
# WAQI (World Air Quality Index) API token
# Get a free token from: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=""

# ── Auth ──────────────────────────────────────
# Secret used to sign session tokens — generate a long random string
# e.g. openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ── Redis (optional, recommended for production) ──
# Upstash Redis for production OTP storage and rate limiting
# Get from: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── App ───────────────────────────────────────
# Base URL for server-side API calls (set to your deployment URL in production)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
